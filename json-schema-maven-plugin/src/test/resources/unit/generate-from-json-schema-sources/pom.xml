<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example.test</groupId>
  <artifactId>jsonschema-mojo-harness-test</artifactId>
  <version>1.0.0</version>
  <build>
    <plugins>
      <plugin>
        <groupId>io.micronaut.jsonschema</groupId>
        <artifactId>micronaut-json-schema-maven-plugin</artifactId>
        <configuration>
          <jdbcUrl>jdbc:oracle:thin:@localhost:1521/FREEPDB1</jdbcUrl>
          <username>app</username>
          <password>secret</password>
          <targetPackage>io.micronaut.jsonschema.oracle.generated</targetPackage>
          <schemaCacheDir>target/jsonschema-cache</schemaCacheDir>
          <outputDir>target/generated-sources/jsonschema</outputDir>
          <sources>
            <source>
              <name>domains</name>
              <provider>oracle-domains</provider>
              <options>
                <owner>APP</owner>
              </options>
              <optionValues>
                <include>
                  <value>APP_JSON</value>
                  <value>ALT_JSON</value>
                </include>
              </optionValues>
            </source>
            <source>
              <name>views</name>
              <provider>oracle-duality-views</provider>
              <options>
                <owner>APP</owner>
                <include>APP_VIEW</include>
              </options>
            </source>
          </sources>
          <skipOnError>true</skipOnError>
          <failOnMissingSource>false</failOnMissingSource>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
