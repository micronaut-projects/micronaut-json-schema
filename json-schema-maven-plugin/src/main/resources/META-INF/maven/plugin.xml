<plugin>
  <name>Micronaut JSON Schema Records Maven Plugin</name>
  <description>Generates Java records from JSON Schemas.</description>
  <groupId>io.micronaut.jsonschema</groupId>
  <artifactId>micronaut-json-schema-maven-plugin</artifactId>
  <version>${project.version}</version>
  <goalPrefix>micronaut-json-schema</goalPrefix>
  <mojos>
    <mojo>
      <goal>generate-from-json-schema-sources</goal>
      <description>Discovers JSON Schemas from configured sources and generates Java records or classes.</description>
      <implementation>io.micronaut.jsonschema.maven.GenerateFromJsonSchemaSourcesMojo</implementation>
      <language>java</language>
      <phase>generate-sources</phase>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <requiresDirectInvocation>false</requiresDirectInvocation>
      <requiresProject>true</requiresProject>
      <requiresReports>false</requiresReports>
      <aggregator>false</aggregator>
      <requiresOnline>false</requiresOnline>
      <inheritedByDefault>true</inheritedByDefault>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter>
          <name>jdbcUrl</name>
          <type>java.lang.String</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>username</name>
          <type>java.lang.String</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>password</name>
          <type>java.lang.String</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>serverId</name>
          <type>java.lang.String</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>providers</name>
          <type>io.micronaut.jsonschema.maven.GenerateFromJsonSchemaSourcesMojo$ProvidersConfiguration</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>targetPackage</name>
          <type>java.lang.String</type>
          <required>true</required>
        </parameter>
        <parameter>
          <name>languageLevel</name>
          <type>int</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>schemaCacheDir</name>
          <type>java.io.File</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>outputDir</name>
          <type>java.io.File</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>sources</name>
          <type>java.util.List</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>skipOnError</name>
          <type>boolean</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>failOnMissingSource</name>
          <type>boolean</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>skip</name>
          <type>boolean</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>settings</name>
          <type>org.apache.maven.settings.Settings</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>project</name>
          <type>org.apache.maven.project.MavenProject</type>
          <required>true</required>
          <readonly>true</readonly>
        </parameter>
      </parameters>
      <configuration>
        <jdbcUrl implementation="java.lang.String">${jsonSchemaRecords.jdbcUrl}</jdbcUrl>
        <username implementation="java.lang.String">${jsonSchemaRecords.username}</username>
        <password implementation="java.lang.String">${jsonSchemaRecords.password}</password>
        <serverId implementation="java.lang.String">${jsonSchemaRecords.serverId}</serverId>
        <targetPackage implementation="java.lang.String">${jsonSchemaRecords.targetPackage}</targetPackage>
        <languageLevel implementation="int" default-value="21">${jsonSchemaRecords.languageLevel}</languageLevel>
        <schemaCacheDir implementation="java.io.File" default-value="${project.build.directory}/jsonschema-cache" />
        <outputDir implementation="java.io.File" default-value="${project.build.directory}/generated-sources/jsonschema" />
        <skipOnError implementation="boolean" default-value="false">${jsonSchemaRecords.skipOnError}</skipOnError>
        <failOnMissingSource implementation="boolean" default-value="true">${jsonSchemaRecords.failOnMissingSource}</failOnMissingSource>
        <skip implementation="boolean" default-value="true">${jsonSchemaRecords.skip}</skip>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}" />
        <settings implementation="org.apache.maven.settings.Settings" default-value="${settings}" />
      </configuration>
    </mojo>
  </mojos>
</plugin>
