<plugin>
  <name>Micronaut JSON Schema Oracle Generator Maven Plugin</name>
  <description>Generates Java records from Oracle-backed JSON Schemas.</description>
  <groupId>io.micronaut.jsonschema</groupId>
  <artifactId>micronaut-json-schema-maven-plugin</artifactId>
  <version>${project.version}</version>
  <goalPrefix>micronaut-json-schema</goalPrefix>
  <mojos>
    <mojo>
      <goal>generate-from-oracle-json-schema</goal>
      <implementation>io.micronaut.jsonschema.maven.GenerateFromOracleJsonSchemaMojo</implementation>
      <language>java</language>
      <phase>generate-sources</phase>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter>
          <name>jdbcUrl</name>
          <type>java.lang.String</type>
          <required>true</required>
        </parameter>
        <parameter>
          <name>username</name>
          <type>java.lang.String</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>password</name>
          <type>java.lang.String</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>serverId</name>
          <type>java.lang.String</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>targetPackage</name>
          <type>java.lang.String</type>
          <required>true</required>
        </parameter>
        <parameter>
          <name>schemaCacheDir</name>
          <type>java.io.File</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>outputDir</name>
          <type>java.io.File</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>sources</name>
          <type>java.util.List</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>skipOnError</name>
          <type>boolean</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>failOnMissingDb</name>
          <type>boolean</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>skip</name>
          <type>boolean</type>
          <required>false</required>
        </parameter>
        <parameter>
          <name>settings</name>
          <type>org.apache.maven.settings.Settings</type>
          <required>false</required>
        </parameter>
      </parameters>
      <configuration>
        <jdbcUrl implementation="java.lang.String">${oracleJsonSchema.jdbcUrl}</jdbcUrl>
        <username implementation="java.lang.String">${oracleJsonSchema.username}</username>
        <password implementation="java.lang.String">${oracleJsonSchema.password}</password>
        <serverId implementation="java.lang.String">${oracleJsonSchema.serverId}</serverId>
        <targetPackage implementation="java.lang.String">${oracleJsonSchema.targetPackage}</targetPackage>
        <schemaCacheDir implementation="java.io.File" default-value="${project.build.directory}/oracle-jsonschema-cache" />
        <outputDir implementation="java.io.File" default-value="${project.build.directory}/generated/sources/oracle-jsonschema" />
        <skipOnError implementation="boolean" default-value="false">${oracleJsonSchema.skipOnError}</skipOnError>
        <failOnMissingDb implementation="boolean" default-value="true">${oracleJsonSchema.failOnMissingDb}</failOnMissingDb>
        <skip implementation="boolean" default-value="true">${oracleJsonSchema.skip}</skip>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}" />
        <settings implementation="org.apache.maven.settings.Settings" default-value="${settings}" />
      </configuration>
    </mojo>
  </mojos>
</plugin>
